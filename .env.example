# GEMINI_API_KEY: Server-side API key for Engine F (AI Resource Operations Agent)
GEMINI_API_KEY=

# APP_URL: Public URL of the deployed application
APP_URL=http://localhost:3000

# SESSION_SECRET: Optional HMAC signing secret for session tokens (auto-generated in-memory if omitted)
SESSION_SECRET=

# ADMIN_PASSCODE: Optional server-side administrator passcode (if unset, use first-run Admin Claim UI)
ADMIN_PASSCODE=

# SUPABASE_URL: Optional Supabase project URL for production PostgreSQL persistence
SUPABASE_URL=

# SUPABASE_ANON_KEY: Optional Supabase public anon key
SUPABASE_ANON_KEY=
